<section id="contact" class="section section--contact" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <div class="contact-copy reveal">
      <p class="eyebrow">Get in touch</p>
      <h2 id="contact-title">Let’s build something useful.</h2>
      <p>
        I’m looking for an internship or early-career full-stack or backend role where I can contribute to real products, learn from experienced engineers, and keep sharpening my systems thinking.
      </p>

      <a class="contact-email" href="mailto:mridul1013@gmail.com">
        <span>Email</span>
        mridul1013@gmail.com
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
      </a>

      <div class="social-links" aria-label="Social links">
        <a href="https://github.com/Haque31" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/mridul-haque/" target="_blank" rel="noreferrer">LinkedIn</a>
      </div>
    </div>

    <form class="contact-form reveal" data-contact-form>
      <div class="form-row">
        <label>
          <span>Name</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
      </div>
      <label>
        <span>Subject</span>
        <input type="text" name="subject" required />
      </label>
      <label>
        <span>Message</span>
        <textarea name="message" rows="6" required></textarea>
      </label>
      <button class="button button--primary" type="submit">
        Open in email app
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
      </button>
      <p class="form-note" data-form-note>This static form prepares an email in your default email application. No form data is stored by this site.</p>
    </form>
  </div>
</section>
